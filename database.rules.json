{
  "rules": {
    "rooms": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status"]
    },
    "leaderboard": {
      ".read": true,
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "tournoi": {
      ".read": true,
      "$weekKey": {
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },
    "users": {
      "$uid": { ".read": true, ".write": "auth != null && auth.uid === $uid" }
    },
    "friendCodes": { ".read": "auth != null", ".write": "auth != null" },
    "friends": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" }
    },
    "friendRequests": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null" }
    }
  }
}
