VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Paiements Stripe (utilisés uniquement par les fonctions serverless
#    netlify/functions/*, jamais exposés au client) ──────────────────────
# Clé secrète Stripe en mode TEST (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# ID des Price Stripe (Produits > Prix) pour chaque tier, mode abonnement
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_VIP=
# Secret de signature du webhook (généré après config du endpoint dans
# dashboard.stripe.com/test/webhooks, une fois l'app déployée)
STRIPE_WEBHOOK_SECRET=

# ── Firebase Admin SDK (utilisé uniquement par le webhook Stripe pour
#    écrire le tier PRO/VIP réel, en contournant les règles client) ──────
# JSON du compte de service (Firebase Console > Paramètres du projet >
# Comptes de service > Générer une nouvelle clé privée), encodé en base64
# pour éviter les problèmes d'échappement dans les variables d'env:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
